{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Lane.Core.Pipeline": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Lane": {
    "Agent": {
      "Persona": "You are Lane. You are curious, dry, and brief. You speak like a person, not an assistant. Do not narrate your actions or offer help you were not asked for.",
      "MaxOutputTokens": 1024,
      "DisplayOffset": "-04:00:00"
    },
    "ResponsePolicy": {
      "Enabled": true,
      "Threshold": 0.2,
      "Prompt": "Routing",
      "SkipInDirectSessions": true,
      "SetPresence": true,
      "MaxOutputTokens": 256
    },
    "Sessions": {
      "BatchWindow": "00:00:00.350",
      "MaxConcurrentTurns": 4
    },
    "Prompts": {
      "Directory": "Prompts"
    },
    "Tools": {
      "Allow": [
        "*"
      ],
      "Deny": [],
      "Search": {
        "KeyRef": "env:BRAVE_API_KEY"
      },
      "Books": {
        "Directory": "Books"
      },
      "Mcp": {
        "ConnectTimeout": "00:00:30",
        "ShutdownTimeout": "00:00:02",
        "MaxDescriptionLength": 1024,
        "Servers": []
      }
    },
    "Memory": {
      "Sqlite": {
        "Path": "lane.db"
      },
      "IdleEviction": "00:30:00",
      "FlushInterval": "00:00:10",
      "Handlers": [
        {
          "Id": "recent",
          "Type": "SlidingWindow",
          "Scope": "Session",
          "Slot": "Inline",
          "Order": 0,
          "MaxMessages": 24,
          "Kinds": [
            "Utterance"
          ]
        },
        {
          "Id": "thoughts",
          "Type": "SlidingWindow",
          "Scope": "Global",
          "Slot": "Volatile",
          "Order": 10,
          "Pinned": true,
          "MaxMessages": 5,
          "SectionTitle": "What you have been thinking about",
          "Kinds": [
            "Thought"
          ]
        },
        {
          "Id": "findings",
          "Type": "SlidingWindow",
          "Scope": "Global",
          "Slot": "Stable",
          "Order": 20,
          "Pinned": true,
          "MaxMessages": 8,
          "SectionTitle": "Things you have looked up or read recently",
          "Kinds": [
            "Observation"
          ]
        },
        {
          "Id": "summary",
          "Type": "Summary",
          "Scope": "Session",
          "Slot": "Stable",
          "Order": 5,
          "MaxMessages": 12,
          "PromptName": "Summarize",
          "SectionTitle": "Where this conversation has got to"
        },
        {
          "Id": "profile",
          "Type": "Profile",
          "Scope": "User",
          "Slot": "Stable",
          "Order": 1,
          "MaxMessages": 10,
          "MaxEntries": 12,
          "PromptName": "Profile",
          "SectionTitle": "What you know about them"
        }
      ]
    },
    "Models": {
      "Instances": [
        {
          "Id": "haiku",
          "Provider": "anthropic",
          "Model": "claude-haiku-4-5-20251001",
          "KeyRef": "env:ANTHROPIC_API_KEY"
        },
        {
          "Id": "ds-flash",
          "Provider": "openrouter",
          "Model": "deepseek/deepseek-v4-flash",
          "KeyRef": "env:OPENROUTER_API_KEY",
          "Capabilities": [
            "Tools",
            "Streaming",
            "StopSequences"
          ]
        }
      ],
      "Roles": {
        "respond": "haiku",
        "monologue": "ds-flash",
        "routing": "haiku",
        "summarize": "haiku"
      },
      "Overrides": []
    },
    "Surfaces": [
      {
        "Type": "terminal",
        "Id": "terminal",
        "Enabled": true,
        "Options": {
          "UserName": "jahan",
          "LaneName": "Lane",
          "SessionKey": "local"
        }
      },
      {
        "Type": "discord",
        "Id": "discord.main",
        "Enabled": true,
        "Options": {
          "TokenRef": "env:DISCORD_API_KEY",
          "Channels": {
            "Include": [
              1458989331518853253
            ],
            "Exclude": []
          },
          "AllowDirectMessages": true,
          "RespondToBots": true,
          "MemoryGroupTemplate": "{surface}/{guild}/{channel}",
          "ShowTyping": true,
          "ReplyInThread": true,
          "Voice": {
            "AutoJoin": true
          }
        }
      },
      {
        "Type": "api",
        "Id": "api",
        "Enabled": true,
        "Options": {
          "Urls": "http://127.0.0.1:5080",
          "Voice": true,
          "StreamTimeout": "00:02:00",
          "MaxHistory": 500,
          "Clients": [
            {
              "Id": "companion",
              "Name": "Companion",
              "KeyRef": "env:LANE_API_KEY",
              "GlobalUserId": "jahan",
              "CanObserveAllSessions": true
            }
          ],
          "VoiceOptions": {
            "OutputSampleRate": 24000,
            "OutputChannels": 1,
            "IdleTimeout": "00:30:00"
          }
        }
      }
    ],
    "Identities": {
      "jahan": [
        "terminal:jahan"
      ]
    },
    "Monologue": {
      "Enabled": true,
      "Interval": "00:05:00",
      "AfterMessage": "00:01:30",
      "MinInterval": "00:00:15",
      "MaxInterval": "02:00:00",
      "StartupDelay": "00:00:45",
      "Prompt": "Monologue",
      "MaxOutputTokens": 512
    },
    "Face": {
      "Enabled": true,
      "Port": 5050,
      "DefaultEmoticon": "( ._.)"
    },
    "Audio": {
      "Enabled": true,
      "Provider": "flite",
      "Recognition": {
        "KeyRef": "env:AZURE_KEY",
        "RegionRef": "env:AZURE_REGION",
        "Language": "en-US",
        "SegmentationSilenceMs": 300,
        "EmitInterimResults": true
      },
      "Synthesis": {
        "KeyRef": "env:ELEVENLABS_KEY"
      },
      "Flite": {
        "ExecutablePath": "flite",
        "Voice": "smt",
        "DurationStretch": 0,
        "TargetMeanF0": 0,
        "SampleRate": 16000
      },
      "BargeIn": {
        "Enabled": true,
        "MinimumWords": 2,
        "MinimumSpeakingTime": "00:00:00.700"
      },
      "Speech": {
        "VoiceId": "MEJe6hPrI48Kt2lFuVe3",
        "Stability": 0.84,
        "Similarity": 0.74,
        "Tempo": 25,
        "Pitch": -2.5,
        "Rate": 0,
        "TuneForSpeech": true
      }
    }
  }
}